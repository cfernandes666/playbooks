---
# Copie para aap_auth.yml e preencha os valores.
# Não versionar aap_auth.yml com o token real.
#
#   cp vars/aap_auth.yml.example vars/aap_auth.yml
#
# Alternativa: exportar variáveis de ambiente
#   AAP_HOSTNAME / AAP_TOKEN / AAP_VALIDATE_CERTS

aap_hostname: "https://automation-gateway-aap.apps.exemplo.local"
aap_token: "<TOKEN_OAUTH2_DO_GATEWAY>"
aap_validate_certs: true
